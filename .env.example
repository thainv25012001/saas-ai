# ---- Where the infrastructure lives ----------------------------------------
# Leave this set to run Postgres and Redis as local containers. Comment it out
# when DATABASE_URL / REDIS_URL below point at managed services, and those
# containers are never started.
COMPOSE_PROFILES=local-infra

# ---- Database -------------------------------------------------------------
# TWO roles, deliberately. The app connects as a role that does NOT own the
# tables, so PostgreSQL Row-Level Security applies to it; migrations connect as
# the owner. Pointing both at the same role makes that role the table owner, and
# a table owner BYPASSES ITS OWN RLS POLICIES — tenant isolation then stops
# applying with no error anywhere, while every test still passes. This is the
# single easiest thing to get wrong in this file.
#
# These are LEFT UNSET on purpose. `docker compose up` then uses the compose
# defaults, which address the local containers by service name (`db:5432`) — the
# only hostname that resolves from inside the API container.
#
# Uncomment these two ONLY if you run the API natively on the host
# (`cd apps/api && uv run uvicorn ...`), where `db` does not resolve:
#   DATABASE_URL=postgresql+asyncpg://app_user:app_user_password@localhost:5432/saas_ai
#   MIGRATION_DATABASE_URL=postgresql+asyncpg://app_owner:app_owner_password@localhost:5432/saas_ai
#
# One `.env` cannot serve both at once while using local containers, because the
# two need different hostnames for the same database. Managed URLs do not have
# that problem — they resolve identically from the host and from a container,
# which is the main reason the managed setup is simpler to run.

# Managed Postgres (Neon, Supabase, Render, Heroku) — paste the URL as given.
# The scheme and libpq-only parameters (`sslmode`, `channel_binding`) are
# normalized at startup, so no hand-editing is needed. Create the two roles once
# against the managed instance; infrastructure/postgres/init.sql only ever runs
# against an empty LOCAL data directory, never against a managed database.
#   DATABASE_URL=postgresql://app_user:...@ep-xxx.neon.tech/neondb?sslmode=require
#   MIGRATION_DATABASE_URL=postgresql://app_owner:...@ep-xxx.neon.tech/neondb?sslmode=require

# ---- Redis ----------------------------------------------------------------
# Unset for the same reason as the database URLs above: compose defaults to
# `redis://redis:6379/0`, the service name reachable from the API container.
# Uncomment for a native run, or replace with a managed URL.
#   REDIS_URL=redis://localhost:6379/0
# Managed (Upstash and friends) use TLS: rediss://default:<password>@<host>:6379

# ---- Security -------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# ---- App ------------------------------------------------------------------
ENVIRONMENT=local
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# ---- Web ------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
# Only needed when the Next server reaches the API at a different address than
# the browser does -- Docker Compose, where the browser uses the published host
# port above and the server has to use the service name. `docker-compose.yml`
# sets it for the `web` container; leave it unset everywhere else and the proxy
# rewrite falls back to NEXT_PUBLIC_API_URL.
# API_INTERNAL_URL=http://api:8000

# ---- LLM providers ---------------------------------------------------------
# Leave all of these unset to use the deterministic `fake` provider, which
# needs no network and makes the playground work out of the box.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OpenRouter fronts many vendors behind OpenAI's API. Models whose id ends in
# `:free` cost nothing, at the price of a hard rate limit (~20 req/min, and
# 50 req/day until the account holds credits). Key from openrouter.ai/keys.
# OPENROUTER_API_KEY=
DEFAULT_LLM_PROVIDER=fake
